{
  "version": 2,
  "functions": {
    "api/**/*.php": {
      "runtime": "vercel-php@0.9.0",
      "includeFiles": "web/**",
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/(assets|uploads)/(.*)",
      "dest": "/web/public/$1/$2"
    },
    {
      "src": "/(css|js|img|vendor)/(.*)",
      "dest": "/web/public/assets/$1/$2"
    },
    {
      "src": "/(favicon.ico|manifest.json|offline.html|sw.js)",
      "dest": "/web/public/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php?url=$1"
    }
  ],
  "crons": [
    {
      "path": "/api/cron_auto_alfa.php",
      "schedule": "0 10 * * *"
    }
  ]
}
