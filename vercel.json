{
  "version": 2,
  "functions": {
    "api/**/*.php": {
      "runtime": "vercel-php@0.9.0",
      "includeFiles": "web/**",
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/sw.js",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      },
      "dest": "/web/public/sw.js"
    },
    {
      "src": "/manifest.json",
      "headers": {
        "Cache-Control": "public, max-age=86400"
      },
      "dest": "/web/public/manifest.json"
    },
    {
      "src": "/assets/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "dest": "/web/public/assets/$1"
    },
    {
      "src": "/uploads/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=604800, stale-while-revalidate=86400"
      },
      "dest": "/web/public/uploads/$1"
    },
    {
      "src": "/(css|js|img|vendor)/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "dest": "/web/public/assets/$1/$2"
    },
    {
      "src": "/(favicon.ico|offline.html)",
      "dest": "/web/public/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php?url=$1"
    }
  ],
  "crons": [
    {
      "path": "/api/cron_auto_alfa.php",
      "schedule": "0 10 * * *"
    }
  ]
}
