:{$PORT:80} {
    root * /app/web/public
    encode zstd gzip

    # Static assets handling
    @static {
        file
        path *.css *.js *.png *.jpg *.jpeg *.gif *.ico *.svg *.webp *.woff *.woff2 *.ttf *.eot
    }
    handle @static {
        file_server
    }

    # FrankenPHP PHP server routing to web/public/index.php
    php_server {
        try_files {path} /index.php?url={path}
    }
}
